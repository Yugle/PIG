{
  "id": "system_config",
  "name": "系统设置与个性化调节",
  "version": "1.0.0",
  "author": "Antigravity Lab",
  "category": "系统工具",
  "description": "动态修改 PIG 的系统配置、个性化称呼与硬件开关。支持自然语言语音指令：调节音量（如'音量调大'/'音量设为80%'/'静音'）、开启/熄灭屏幕及背光（如'熄屏'/'打开屏幕'/'屏幕亮度50%'）、安全关机/重启服务（如'关机'/'重启服务'）、开启/关闭人脸追踪、开启/关闭主动关怀、修改主人称呼（如'以后叫我胖虎'）、修改机器人名字（如'你以后叫小丸子'）、开启/关闭萌趣非语言音效、查询当前配置等。",
  "parameters": {
    "action": {
      "type": "string",
      "description": "配置类型：'volume' (调节音量), 'screen' (屏幕/背光开关或亮度), 'power' (安全关机 'shutdown' 或重启服务 'restart'), 'face_tracking' (人脸追踪开关), 'proactive_care' (主动关怀开关), 'user_name' (设置主人名字), 'bot_name' (设置机器人名字), 'non_verbal_audio' (设置萌趣音效), 'query' (查询当前配置)",
      "default": "query"
    },
    "value": {
      "type": "string",
      "description": "需要设置的值：对于音量传入数字如 '80' 或 'up'/'down'/'mute'；对于屏幕传入 'true'/'false'/'on'/'off' 或亮度数字 '50'；对于开关机传入 'shutdown'/'restart'；对于开关类传入 'true'/'false'/'on'/'off'；对于名字类传入新的名字字符串（如 '胖虎', '小丸子'）",
      "default": ""
    }
  },
  "default_behavior": {
    "emotion": "HAPPY",
    "action": "NOD"
  },
  "protected": true,
  "fast_path": true,
  "query_keywords": [
    "query",
    "查"
  ],
  "aliases": [
    "config",
    "setting",
    "shezhi",
    "peizhi",
    "system_config",
    "face_tracking",
    "track"
  ],
  "fast_local_intents": [
    {
      "triggers": ["音量调大", "音量大点", "声音大点", "音量调高", "声音调大", "大声点"],
      "args": {"action": "volume", "value": "+"},
      "emotion": "HAPPY"
    },
    {
      "triggers": ["音量调小", "音量小点", "声音小点", "音量调低", "声音调小", "小声点"],
      "args": {"action": "volume", "value": "-"},
      "emotion": "NORMAL"
    },
    {
      "triggers": ["静音", "打开静音"],
      "args": {"action": "volume", "value": "mute"},
      "emotion": "NORMAL"
    },
    {
      "triggers": ["取消静音", "关闭静音", "恢复声音"],
      "args": {"action": "volume", "value": "60"},
      "emotion": "HAPPY"
    },
    {
      "triggers": ["开启人脸追踪", "打开人脸追踪", "开启人脸跟随", "打开人脸跟随"],
      "args": {"action": "face_tracking", "value": "true"},
      "reply": "好嘞，已开启人脸追踪！",
      "emotion": "HAPPY"
    },
    {
      "triggers": ["关闭人脸追踪", "关掉人脸追踪", "关闭人脸跟随", "关掉人脸跟随"],
      "args": {"action": "face_tracking", "value": "false"},
      "reply": "好的，已关闭人脸追踪。",
      "emotion": "NORMAL"
    },
    {
      "triggers": ["熄屏", "息屏", "关屏", "关闭屏幕", "关掉屏幕", "把屏幕关了", "把屏幕熄灭", "熄灭屏幕", "关闭背光", "关背光"],
      "args": {"action": "screen", "value": "false"},
      "reply": "好嘞，屏幕和背光都给你彻底关掉啦。",
      "emotion": "SLEEPY"
    },
    {
      "triggers": ["亮屏", "开屏", "打开屏幕", "开启屏幕", "点亮屏幕", "把屏幕打开", "唤醒屏幕", "恢复屏幕"],
      "args": {"action": "screen", "value": "true"},
      "reply": "屏幕已经重新点亮啦！",
      "emotion": "HAPPY"
    },
    {
      "triggers": ["关机", "安全关机", "我要关机", "把小猪关机", "关闭系统"],
      "args": {"action": "power", "value": "shutdown"},
      "emotion": "SLEEPY"
    },
    {
      "triggers": ["重启服务", "重启小猪", "重新启动"],
      "args": {"action": "power", "value": "restart"},
      "emotion": "NORMAL"
    }
  ]
}
