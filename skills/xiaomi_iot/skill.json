{
  "id": "xiaomi_iot",
  "name": "小米米家生态直控",
  "version": "1.2.0",
  "http_prefixes": ["/api/xiaomi"],
  "author": "Mijia Eco Team",
  "category": "智能物联",
  "description": "查询与控制米家生态智能设备（台灯、水壶、摄像机、饮水机、电视盒子等）或扫码绑定。当主人询问'家里有什么设备'、'我米家都有什么设备'、'查一下米家设备'时必须调用此技能（参数: device='all', action='查询设备列表'）；亦支持开关、调节与扫码绑定。",
  "parameters": {
    "device": {
      "type": "string",
      "description": "目标设备名，如 '台灯', '水壶', '摄像机', '饮水机', '电视盒子'，或查询全部设备列表时传 'all'",
      "default": "台灯"
    },
    "action": {
      "type": "string",
      "description": "动作指令，如 '查询设备列表', '打开', '关闭', '调成暖光', '调亮', '恒温50度', '开始扫地', '回充', '扫码绑定'。",
      "default": "打开"
    },
    "value": {
      "type": "string",
      "description": "调节数值或复合动作，如 '亮度50%', '3000K', '暖光', '55度' 等。",
      "default": ""
    }
  },
  "default_behavior": {
    "emotion": "WINK",
    "action": "NOD"
  },
  "config_schema": {
    "title": "小米米家智能生态",
    "summary": "支持手机端直接生成米家扫码二维码，或投屏到小猪 2.4 寸屏幕扫码，同步全部设备与局域网控制 Token。",
    "config_section": "none",
    "screen_menu": true,
    "status_endpoint": "/api/xiaomi/qr_status",
    "auth": {
      "type": "web_or_screen_qr",
      "label": "生成网页扫码二维码",
      "screen_label": "投屏到小猪屏幕扫码",
      "start_endpoint": "/api/xiaomi/qr_start",
      "screen_start_endpoint": "/api/xiaomi/qr_start_screen",
      "poll_endpoint": "/api/xiaomi/qr_status"
    },
    "fields": []
  },
  "protected": true,
  "fast_path": true,
  "query_keywords": [
    "查",
    "看",
    "列表",
    "有哪些",
    "什么设备",
    "清单",
    "query",
    "list",
    "all",
    "所有"
  ],
  "aliases": [
    "xiaomi",
    "mijia",
    "miot",
    "xiaoai",
    "mi_home"
  ],
  "default_query_args": {
    "triggers": [
      "query",
      "list",
      "all",
      "查",
      "看",
      "设备",
      "清单"
    ],
    "defaults": {
      "device": "all",
      "action": "查询设备列表"
    }
  },
  "screen_qr_mode": "XIAOMI_QR",
  "screen_qr_title": "米家授权"
}
